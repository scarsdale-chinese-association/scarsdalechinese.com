---
/**
 * Board grid. Shows a headshot when `photo` is set, otherwise a red-on-cream head silhouette
 * (the old WordPress site used the same idea). `avatar: "female"` picks the long-hair silhouette;
 * anything else gets the short-hair bust. On /zh/ pages roles are translated via `board.role.<Role>`
 * keys in src/i18n/ui.ts and `nameZh` is shown when set.
 */
import { getCollection } from "astro:content";
import { tOptional, useTranslations, type Locale } from "../i18n/utils";
interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
const members = (await getCollection("board")).sort((a, b) => a.data.order - b.data.order);
---
<ul class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5" role="list">
  {members.map((m) => {
    const name = locale === "zh" ? m.data.nameZh ?? m.data.name : m.data.name;
    const role = tOptional(locale, `board.role.${m.data.role}`, m.data.role);
    return (
    <li class="flex flex-col items-center rounded-xl bg-white p-5 text-center shadow-card ring-1 ring-line/60">
      {m.data.photo ? (
        <img src={m.data.photo} alt={t("board.portraitAlt", { name })} class="h-24 w-24 rounded-full object-cover ring-4 ring-cream" loading="lazy" width="96" height="96" />
      ) : (
        <svg class="h-24 w-24 rounded-full bg-cream text-red ring-4 ring-cream" viewBox="0 0 96 96" aria-hidden="true" focusable="false">
          {m.data.avatar === "female" ? (
            <path fill="currentColor" d="M48 14c-12.5 0-20 9.5-20 24 0 9-1.5 14.5-5 19.5-.6.8-.2 2 .8 2.3 5.4 1.7 11 2.7 16 3.3-.1 4.6-3.3 6.7-9 8.6C21.4 75 16 78.5 16 86v2h64v-2c0-7.5-5.4-11-14.8-14.3-5.7-1.9-8.9-4-9-8.6 5-.6 10.6-1.6 16-3.3 1-.3 1.4-1.5.8-2.3-3.5-5-5-10.5-5-19.5 0-14.5-7.5-24-20-24z" />
          ) : (
            <path fill="currentColor" d="M48 16c-9.4 0-16 7.4-16 17.5S38.6 52 48 52s16-8.4 16-18.5S57.4 16 48 16zm0 42c-16 0-32 8-32 22v8h64v-8c0-14-16-22-32-22z" />
          )}
        </svg>
      )}
      <p class="mt-4 font-bold text-ink">{name}</p>
      {locale === "zh" && m.data.nameZh && <p lang="en" class="text-xs text-muted">{m.data.name}</p>}
      <p class="text-sm text-muted">{role}</p>
    </li>
    );
  })}
</ul>
