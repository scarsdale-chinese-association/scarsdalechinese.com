---
import { site, nav } from "../lib/site";
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-white/95 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4 sm:h-20">
    <a href="/" class="flex items-center gap-3 text-base font-bold text-ink sm:text-lg lg:text-xl" aria-label={`${site.name} home`}>
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red text-sm font-extrabold text-white">SCA</span>
      <span class="leading-tight">Scarsdale Chinese<span class="hidden sm:inline"> Association</span></span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} class:list={["text-[15px] font-semibold text-ink/80 transition hover:text-red", { "text-red": isActive(item.href) }]} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
      <a href="/join/" class="btn-red px-6">Join SCA</a>
    </nav>

    <div class="flex items-center gap-3 lg:hidden">
      <a href="/join/" class="btn-red px-4 py-2 text-xs sm:text-sm">Join SCA</a>
      <button id="nav-toggle" type="button" class="grid h-10 w-10 place-items-center rounded-md border border-line text-ink" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-line/60 bg-white lg:hidden">
    <nav class="container-site flex flex-col py-2" aria-label="Mobile">
      <a href="/" class="py-3 text-base font-semibold text-ink/80">Home</a>
      {nav.map((item) => (
        <a href={item.href} class:list={["border-t border-line/50 py-3 text-base font-semibold text-ink/80", { "text-red": isActive(item.href) }]}>{item.label}</a>
      ))}
      <a href="/join/" class="border-t border-line/50 py-3 text-base font-semibold text-red">Join SCA · Become a member</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
