---
/**
 * RSVP form for upcoming events. Posts form="rsvp" to the Apps Script endpoint,
 * which appends a row to the `rsvp` tab of the SCA Members sheet and emails info@.
 */
interface Props { eventTitle: string; eventSlug: string; eventDate: string; }
const { eventTitle, eventSlug, eventDate } = Astro.props;
---
<form data-sca-form="rsvp" data-success={`/thank-you/?form=rsvp&event=${encodeURIComponent(eventTitle)}`} class="space-y-4" novalidate>
  <input type="hidden" name="eventTitle" value={eventTitle} />
  <input type="hidden" name="eventSlug" value={eventSlug} />
  <input type="hidden" name="eventDate" value={eventDate} />
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="label" for="r-name">Name <span class="text-red">*</span></label><input class="field" id="r-name" name="name" autocomplete="name" required /></div>
    <div><label class="label" for="r-email">Email <span class="text-red">*</span></label><input class="field" id="r-email" name="email" type="email" autocomplete="email" required /></div>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="label" for="r-phone">Phone <span class="font-normal text-muted">· optional</span></label><input class="field" id="r-phone" name="phone" type="tel" autocomplete="tel" /></div>
    <div>
      <label class="label" for="r-guests">How many people, including you? <span class="text-red">*</span></label>
      <select class="field" id="r-guests" name="guests" required>
        {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option value={n}>{n}</option>)}
      </select>
    </div>
  </div>
  <div><label class="label" for="r-note">Anything we should know? <span class="font-normal text-muted">· kids' ages, dietary needs, questions</span></label><textarea class="field min-h-24" id="r-note" name="note"></textarea></div>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <button type="submit" class="btn-red w-full py-3.5 text-base sm:w-auto sm:px-10">I'll be there</button>
  <p data-status class="mt-3 text-sm text-muted" aria-live="polite"></p>
</form>
