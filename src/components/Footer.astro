---
import { site, nav } from "../lib/site";
import { localizePath, useTranslations, type Locale } from "../i18n/utils";
interface Props { locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
const l = (href: string) => localizePath(href, locale);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t-4 border-red bg-ink text-cream">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">{locale === "zh" ? site.nameZh : site.name}</p>
      {locale === "zh" && <p class="text-sm text-cream/70">{site.name}</p>}
      <p class="mt-2 max-w-sm text-sm text-cream/70">{t("footer.blurb", { year: site.foundedYear })}</p>
    </div>
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-gold">{t("footer.explore")}</p>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((i) => (<li><a href={l(i.href)} class="hover:text-gold">{locale === "zh" ? i.labelZh : i.label}</a></li>))}
        <li><a href={l("/join/")} class="font-semibold text-white hover:text-gold">{t("footer.becomeMember")}</a></li>
        <li><a href={`${l("/sponsors/")}#become-a-sponsor`} class="hover:text-gold">{t("footer.becomeSponsor")}</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-gold">{t("footer.contact")}</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={`mailto:${site.email}`} class="hover:text-gold">{site.email}</a></li>
        <li><a href={site.phoneHref} class="hover:text-gold">{site.phone}</a></li>
        {locale === "zh" ? (
          <>
            <li>{site.addressZh}</li>
            <li lang="en" class="text-cream/70">{site.address}</li>
          </>
        ) : (
          <>
            <li>{site.address}</li>
            <li lang="zh-CN" class="text-cream/70">{site.addressZh}</li>
          </>
        )}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-2 py-5 text-xs text-cream/60 sm:flex-row sm:items-center sm:justify-between">
      <p>{t("footer.copyright", { range: `${site.foundedYear}–${year}` })}</p>
      <p><a href="https://github.com/scarsdale-chinese-association/scarsdalechinese.com" class="hover:text-gold" rel="noopener">{t("footer.source")}</a></p>
    </div>
  </div>
</footer>
