---
import { site, nav } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-cream text-ink">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="text-lg font-bold">{site.name}</p>
      <p class="mt-2 max-w-sm text-sm text-muted">A 501(c)(3) non-profit, non-political organization serving the Chinese community of Scarsdale, New York since {site.foundedYear}.</p>
    </div>
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.map((i) => (<li><a href={i.href} class="hover:text-red">{i.label}</a></li>))}
        <li><a href="/join/" class="font-semibold hover:text-red">Become a member</a></li>
        <li><a href="/sponsors/#become-a-sponsor" class="hover:text-red">Become a sponsor</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-bold uppercase tracking-wide text-red">Contact</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={`mailto:${site.email}`} class="hover:text-red">{site.email}</a></li>
        <li><a href={site.phoneHref} class="hover:text-red">{site.phone}</a></li>
        <li>{site.address}</li>
        <li lang="zh-Hans" class="text-muted">{site.addressZh}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line/70">
    <div class="container-site flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {site.foundedYear}–{year} Scarsdale Chinese Association, Inc. All rights reserved.</p>
      <p><a href="https://github.com/scarsdale-chinese-association/scarsdalechinese.com" class="hover:text-red" rel="noopener">Site source on GitHub</a></p>
    </div>
  </div>
</footer>
