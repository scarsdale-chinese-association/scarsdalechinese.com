---
/**
 * Shared client-side handler for every form on the site.
 * Any <form data-sca-form="<type>" data-success="<url>"> is posted as JSON (text/plain body, so no CORS preflight)
 * to the Apps Script endpoint. data-success may contain {method} which is replaced by the chosen payment method.
 */
import { formEndpoint } from "../lib/site";
---
<script is:inline define:vars={{ formEndpoint }}>
  window.__SCA_FORM_ENDPOINT = formEndpoint;
</script>
<script>
  const endpoint: string = (window as any).__SCA_FORM_ENDPOINT || "";

  document.querySelectorAll<HTMLFormElement>("form[data-sca-form]").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-status]");
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const started = Date.now();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      // Honeypot and timing: bots fill hidden fields and submit instantly.
      if (data._gotcha) return;
      data.form = form.dataset.scaForm ?? "unknown";
      data.page = location.href;
      data.elapsedMs = String(Date.now() - started);
      delete data._gotcha;

      const method = data.paymentMethod || "";
      const successUrl = (form.dataset.success || "/thank-you/").replace("{method}", method);
      const stripeUrl = form.dataset.stripe || "";

      const say = (msg: string, isError = false) => {
        if (!status) return;
        status.textContent = msg;
        status.className = `mt-3 text-sm ${isError ? "text-red font-semibold" : "text-muted"}`;
      };

      if (!endpoint) {
        say("The form service is not configured yet. Please email info@scarsdalechinese.com instead.", true);
        return;
      }

      if (button) { button.disabled = true; button.dataset.label = button.textContent ?? ""; button.textContent = "Sending…"; }
      say("Sending…");

      try {
        const res = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "text/plain;charset=utf-8" }, body: JSON.stringify(data) });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.ok === false) throw new Error(json.error || `HTTP ${res.status}`);

        if (method === "stripe" && stripeUrl) {
          const url = new URL(stripeUrl);
          if (data.email) url.searchParams.set("prefilled_email", data.email);
          if (json.id) url.searchParams.set("client_reference_id", String(json.id));
          location.assign(url.toString());
          return;
        }
        location.assign(successUrl);
      } catch (err) {
        console.error(err);
        say("Sorry, something went wrong sending the form. Please try again or email info@scarsdalechinese.com.", true);
        if (button) { button.disabled = false; button.textContent = button.dataset.label || "Submit"; }
      }
    });
  });
</script>
