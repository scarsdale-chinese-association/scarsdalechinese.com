---
import { Image } from "astro:assets";
import zelle from "../assets/qr/zelle.png";
import { membership } from "../lib/site";
import { useTranslations, type Locale } from "../i18n/utils";
interface Props { amount?: string; note?: string; locale?: Locale; }
const { locale = "en" } = Astro.props;
const t = useTranslations(locale);
const amount = Astro.props.amount ?? `$${membership.price}`;
const note = Astro.props.note ?? t("zelle.noteDefault");
---
<div class="flex flex-col gap-5 rounded-xl border border-line bg-white p-5 sm:flex-row sm:items-center">
  <Image src={zelle} alt={t("zelle.alt")} class="h-40 w-40 shrink-0 self-center rounded-md" width="160" height="160" />
  <div class="text-sm">
    <p class="text-base font-bold text-red">{t("zelle.title")}</p>
    <p class="mt-1">{t("zelle.scan")}</p>
    <p class="mt-2 font-semibold">{membership.zelle.recipient}</p>
    <p class="select-all font-mono text-base">{membership.zelle.email}</p>
    <p class="mt-2">{t("zelle.amount")} <strong>{amount}</strong></p>
    <p class="mt-1 text-muted">{note}</p>
  </div>
</div>
