---
---
<form data-sca-form="contact" data-success="/thank-you/?form=contact" class="space-y-4" novalidate>
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class="label" for="c-name">Name <span class="text-red">*</span></label><input class="field" id="c-name" name="name" autocomplete="name" required /></div>
    <div><label class="label" for="c-email">Email <span class="text-red">*</span></label><input class="field" id="c-email" name="email" type="email" autocomplete="email" required /></div>
  </div>
  <div><label class="label" for="c-message">Message <span class="text-red">*</span></label><textarea class="field min-h-36" id="c-message" name="message" required></textarea></div>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <button type="submit" class="btn-red px-10">Send message</button>
  <p data-status class="mt-3 text-sm text-muted" aria-live="polite"></p>
</form>
