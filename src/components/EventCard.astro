---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props { event: CollectionEntry<"events">; large?: boolean; }
const { event } = Astro.props;
const d = event.data;
const dateFmt = new Intl.DateTimeFormat("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<a href={`/events/${event.id}/`} class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-card ring-1 ring-line/60 transition hover:-translate-y-0.5 hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-cream">
    {d.image ? (
      <Image src={d.image} alt={d.imageAlt ?? d.title} class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]" widths={[400, 800, 1200]} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" />
    ) : (
      <div class="grid h-full w-full place-items-center text-6xl text-red/30">福</div>
    )}
    <span class="absolute left-3 top-3 rounded-md bg-red px-2.5 py-1 text-xs font-bold text-white shadow">{dateFmt.format(d.date)}</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold text-ink group-hover:text-red">{d.title}</h3>
    {d.titleZh && <p lang="zh-Hans" class="text-sm text-muted">{d.titleZh}</p>}
    <p class="mt-2 line-clamp-3 text-sm text-muted">{d.summary}</p>
    <div class="mt-auto pt-4 text-sm text-ink/70">
      {d.time && <p>🕘 {d.time}</p>}
      {d.location && <p class="line-clamp-1">📍 {d.location}</p>}
    </div>
  </div>
</a>
