---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { eventDateFormatter, localizePath, type Locale } from "../i18n/utils";
interface Props { event: CollectionEntry<"events">; large?: boolean; locale?: Locale; }
const { event, locale = "en" } = Astro.props;
const d = event.data;
const zh = locale === "zh" ? await getEntry("eventsZh", event.id) : undefined;
const title = zh?.data.title ?? (locale === "zh" ? d.titleZh : undefined) ?? d.title;
const subtitle = locale === "zh" ? (title !== d.title ? d.title : undefined) : d.titleZh;
const summary = zh?.data.summary ?? d.summary;
const time = zh?.data.time ?? d.time;
const location = zh?.data.location ?? d.location;
const dateFmt = eventDateFormatter(locale, "short");
---
<a href={localizePath(`/events/${event.id}/`, locale)} class="group flex flex-col overflow-hidden rounded-xl bg-white shadow-card ring-1 ring-line/60 transition hover:-translate-y-0.5 hover:shadow-lg">
  <div class="relative aspect-[4/3] overflow-hidden bg-cream">
    {d.image ? (
      <Image src={d.image} alt={d.imageAlt ?? d.title} class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]" widths={[400, 800, 1200]} sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw" />
    ) : (
      <div class="grid h-full w-full place-items-center text-6xl text-red/30">福</div>
    )}
    <span class="absolute left-3 top-3 rounded-md bg-red px-2.5 py-1 text-xs font-bold text-white shadow">{dateFmt.format(d.date)}</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-bold text-ink group-hover:text-red">{title}</h3>
    {subtitle && <p lang={locale === "zh" ? "en" : "zh-CN"} class="text-sm text-muted">{subtitle}</p>}
    <p class="mt-2 line-clamp-3 text-sm text-muted">{summary}</p>
    <div class="mt-auto pt-4 text-sm text-ink/70">
      {time && <p>🕘 {time}</p>}
      {location && <p class="line-clamp-1">📍 {location}</p>}
    </div>
  </div>
</a>
