---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import EventCard from "../components/EventCard.astro";
import MembershipForm from "../components/MembershipForm.astro";
import ContactForm from "../components/ContactForm.astro";
import BoardGrid from "../components/BoardGrid.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import FormScript from "../components/FormScript.astro";
import { site, membership } from "../lib/site";
import springStage from "../assets/photos/stage-dance.jpg";
import lionDance from "../assets/photos/lion-dance.jpg";
import membersTable from "../assets/photos/members-table.jpg";
import choir from "../assets/photos/seniors/choir-sca-gala.jpg";

const today = new Date(); today.setHours(0, 0, 0, 0);
const all = (await getCollection("events")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const upcoming = all.filter((e) => e.data.date >= today).sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const showcase = upcoming.length ? upcoming.slice(0, 3) : all.slice(0, 3);
---
<Base title={site.name}>
  <Hero />

  <section class="section bg-white">
    <div class="container-site">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <SectionHeading title={upcoming.length ? "Upcoming events" : "Recent events"} intro={upcoming.length ? "Join us at our next gathering." : "We host a Spring Festival Gala, concerts, coffee mornings, festivals and seminars every year. Here's what we've been up to."} />
        <a href="/events/" class="btn-outline shrink-0">All events</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {showcase.map((e) => <EventCard event={e} />)}
      </div>
    </div>
  </section>

  <section id="join" class="section scroll-mt-20 bg-cream">
    <div class="container-site grid gap-12 lg:grid-cols-[5fr_7fr] lg:items-start">
      <div>
        <SectionHeading title="Become a SCA member" intro={`Family membership is ${membership.priceLabel}. Fill in the form, then pay by card or Zelle. Your whole household is covered.`} />
        <ul class="mt-6 space-y-2 text-[15px] text-ink/85">
          <li class="flex gap-2"><span class="text-red">✓</span> Member pricing at the Spring Festival Gala and ticketed events</li>
          <li class="flex gap-2"><span class="text-red">✓</span> Access to the SCA members' WeChat groups</li>
          <li class="flex gap-2"><span class="text-red">✓</span> Newsletter with local news, school and village updates</li>
          <li class="flex gap-2"><span class="text-red">✓</span> A voice in the association and its programs</li>
        </ul>
        <Image src={springStage} alt="Dancers on stage at the SCA Spring Festival Gala" class="mt-8 hidden aspect-[4/3] w-full rounded-xl object-cover shadow-card lg:block" widths={[480, 960]} sizes="(min-width: 1024px) 40vw, 100vw" />
      </div>
      <div class="rounded-2xl bg-white p-5 shadow-card ring-1 ring-line/60 sm:p-8">
        <MembershipForm compact />
        <p class="mt-4 text-xs text-muted">Questions? See the <a href="/join/#faq" class="underline hover:text-red">membership FAQ</a> or email <a href={`mailto:${site.email}`} class="underline hover:text-red">{site.email}</a>.</p>
      </div>
    </div>
  </section>

  <section id="about" class="section scroll-mt-20 bg-white">
    <div class="container-site grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="grid grid-cols-2 gap-3">
        <Image src={lionDance} alt="Lion dance performance at an SCA celebration" class="col-span-2 aspect-[16/9] w-full rounded-xl object-cover shadow-card" widths={[640, 1280]} sizes="(min-width: 1024px) 50vw, 100vw" />
        <Image src={membersTable} alt="SCA members gathered around a table" class="aspect-square w-full rounded-xl object-cover shadow-card" widths={[320, 640]} sizes="25vw" />
        <Image src={choir} alt="The SCA choir performing in front of the SCA letters at the Spring Festival Gala" class="aspect-square w-full rounded-xl object-cover shadow-card" widths={[320, 640]} sizes="25vw" />
      </div>
      <div>
        <SectionHeading title="About SCA" />
        <div class="prose-sca mt-6">
          <p>Scarsdale Chinese Association (SCA) is a non-profit, non-political organization committed to serving the community of Scarsdale, NY, by promoting the appreciation of Chinese culture and heritage, and by enhancing cross-cultural exchange and understanding.</p>
          <p>Through educational seminars, cultural workshops, social gatherings and community activities, SCA provides opportunities for learning, networking and collaboration among its members and the wider Scarsdale community. Each year we hold lectures and seminars, a large Spring Festival Gala, youth concerts, festivals and coffee mornings.</p>
          <p lang="zh-Hans">斯卡斯代尔华人协会旨在服务华人社区，为会员提供交流互助的平台，弘扬中华文化，并鼓励会员积极参与当地学校和社区的各类组织与活动。</p>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/join/" class="btn-red">Become a member</a>
          <a href="/senior-club/" class="btn-outline">Senior Club</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container-site">
      <SectionHeading title="Thank you to our top sponsors" intro="Your unwavering support fuels our mission to create positive change within the community. Your generosity is the driving force behind every success story we achieve." align="center" />
      <div class="mx-auto mt-10 max-w-4xl"><SponsorGrid tier="top" /></div>
      <div class="mt-10 text-center"><a href="/sponsors/" class="btn-red">See all sponsors · Become a sponsor</a></div>
    </div>
  </section>

  <section id="board" class="section scroll-mt-20 bg-white">
    <div class="container-site">
      <SectionHeading title="The board · Core volunteer team" intro="SCA is run entirely by volunteers. Say hello at our next event." />
      <div class="mt-10"><BoardGrid /></div>
    </div>
  </section>

  <section id="contact" class="section scroll-mt-20 bg-cream">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:items-start">
      <div>
        <SectionHeading title="Have a question?" intro="Send us a message and a board member will get back to you." />
        <ul class="mt-6 space-y-2 text-[15px]">
          <li>✉️ <a href={`mailto:${site.email}`} class="font-semibold hover:text-red">{site.email}</a></li>
          <li>☎️ <a href={site.phoneHref} class="font-semibold hover:text-red">{site.phone}</a></li>
          <li>📮 {site.address}</li>
        </ul>
      </div>
      <div class="rounded-2xl bg-white p-5 shadow-card ring-1 ring-line/60 sm:p-8"><ContactForm /></div>
    </div>
  </section>

  <FormScript />
</Base>
