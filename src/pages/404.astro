---
/**
 * One 404 page for the whole site (Hostinger serves /404.html for any missing URL, so it cannot
 * know which language the visitor wanted). It shows both languages.
 */
import Base from "../layouts/Base.astro";
import { useTranslations } from "../i18n/utils";
const en = useTranslations("en");
const zh = useTranslations("zh");
---
<Base title={`${en("notfound.title")} · ${zh("notfound.title")}`} noindex>
  <section class="section bg-cream"><div class="container-site max-w-xl text-center">
    <p class="text-6xl text-red" aria-hidden="true">福</p>
    <h1 class="mt-4 text-3xl font-bold">{en("notfound.title")}</h1>
    <p class="mt-2 text-muted">{en("notfound.body")}</p>
    <div class="mt-6 flex justify-center gap-3"><a href="/" class="btn-red">{en("notfound.home")}</a><a href="/events/" class="btn-outline">{en("notfound.events")}</a></div>
    <div lang="zh-CN" class="mt-10 border-t border-line pt-8">
      <h2 class="text-2xl font-bold">{zh("notfound.title")}</h2>
      <p class="mt-2 text-muted">{zh("notfound.body")}</p>
      <div class="mt-6 flex justify-center gap-3"><a href="/zh/" class="btn-red">{zh("notfound.home")}</a><a href="/zh/events/" class="btn-outline">{zh("notfound.events")}</a></div>
    </div>
  </div></section>
</Base>
