---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const events = await getCollection("events");
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props;
const { Content } = await render(event);
const d = event.data;
const dateFmt = new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
const isPast = d.date < new Date();
const ld = {
  "@context": "https://schema.org", "@type": "Event", name: d.title, startDate: d.date.toISOString().slice(0, 10), description: d.summary,
  location: d.location ? { "@type": "Place", name: d.location, address: d.address } : undefined,
  organizer: { "@type": "Organization", name: site.name, url: site.url },
  eventStatus: "https://schema.org/EventScheduled",
};
---
<Base title={d.title} description={d.summary}>
  <article class="section">
    <div class="container-site grid gap-10 lg:grid-cols-[5fr_7fr]">
      {d.image && <Image src={d.image} alt={d.imageAlt ?? d.title} class="w-full rounded-2xl shadow-card" widths={[600, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" />}
      <div>
        <a href="/events/" class="text-sm font-semibold text-red hover:underline">← All events</a>
        {isPast && <p class="mt-4 inline-block rounded-md bg-cream px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-muted">Past event</p>}
        <h1 class="mt-3 text-3xl font-bold text-red sm:text-4xl">{d.title}</h1>
        {d.titleZh && <p lang="zh-Hans" class="mt-1 text-lg text-muted">{d.titleZh}</p>}
        <dl class="mt-6 grid gap-3 rounded-xl bg-cream p-5 text-[15px] sm:grid-cols-2">
          <div><dt class="text-xs font-bold uppercase tracking-wide text-muted">Date</dt><dd class="font-semibold">{dateFmt.format(d.date)}</dd></div>
          {d.time && <div><dt class="text-xs font-bold uppercase tracking-wide text-muted">Time</dt><dd class="font-semibold">{d.time}</dd></div>}
          {d.location && <div class="sm:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-muted">Location</dt><dd class="font-semibold">{d.location}{d.address && <span class="block font-normal text-muted">{d.address}</span>}</dd></div>}
        </dl>
        {!isPast && d.rsvpUrl && <a href={d.rsvpUrl} class="btn-red mt-6" rel="noopener">{d.rsvpLabel ?? "RSVP / Register"}</a>}
        <div class="prose-sca mt-8 [&_strong]:font-bold [&_em]:italic"><Content /></div>
      </div>
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
