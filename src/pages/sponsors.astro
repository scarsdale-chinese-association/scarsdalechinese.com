---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SponsorGrid from "../components/SponsorGrid.astro";
import SponsorForm from "../components/SponsorForm.astro";
import Faq from "../components/Faq.astro";
import FormScript from "../components/FormScript.astro";
import { site } from "../lib/site";
import banquet from "../assets/photos/banquet.jpg";
---
<Base title="SCA Sponsors" description="Thank you to the businesses and organizations that sponsor the Scarsdale Chinese Association. Learn how to become a sponsor.">
  <section class="section">
    <div class="container-site">
      <SectionHeading title="Thank you to our top sponsors" intro="Thank you for your unwavering support, which fuels our mission to create positive change within the community. Your generosity is the driving force behind every success story we achieve." />
      <div class="mt-10 max-w-4xl"><SponsorGrid tier="top" /></div>
      <h2 class="mt-16 text-2xl font-bold text-red">More sponsors</h2>
      <div class="mt-6"><SponsorGrid tier="sponsor" /></div>
      <h2 class="mt-16 text-2xl font-bold text-red">Community partners</h2>
      <div class="mt-6"><SponsorGrid tier="partner" /></div>
    </div>
  </section>

  <section id="become-a-sponsor" class="section scroll-mt-20 bg-cream">
    <div class="container-site grid gap-12 lg:grid-cols-[7fr_5fr] lg:items-start">
      <div class="rounded-2xl bg-white p-5 shadow-card ring-1 ring-line/60 sm:p-8">
        <SectionHeading title="Become a sponsor" intro="Thank you for considering a gift to the Scarsdale Chinese Association. We are a 501(c)(3) tax-exempt organization, so all donations are tax deductible." />
        <div class="mt-8"><SponsorForm /></div>
      </div>
      <div>
        <Image src={banquet} alt="Guests at the SCA Spring Festival Gala banquet" class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card" widths={[600, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" />
        <div class="mt-6 rounded-xl bg-white p-5 ring-1 ring-line/60">
          <p class="font-bold">What sponsors receive</p>
          <ul class="mt-3 space-y-2 text-sm text-ink/85">
            <li>· Logo on this website, event materials and social media</li>
            <li>· Recognition in the newsletter and at events</li>
            <li>· Complimentary tickets to the Spring Festival Gala</li>
            <li>· Opportunities to speak or present at events</li>
          </ul>
          <p class="mt-4 text-sm text-muted">Prefer to talk first? Email <a href={`mailto:${site.email}`} class="font-semibold text-red underline">{site.email}</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Faq page="sponsors" />
  <FormScript />
</Base>
