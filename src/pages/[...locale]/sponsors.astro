---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import SponsorGrid from "../../components/SponsorGrid.astro";
import SponsorForm from "../../components/SponsorForm.astro";
import Faq from "../../components/Faq.astro";
import FormScript from "../../components/FormScript.astro";
import { site } from "../../lib/site";
import { getLocale, localeStaticPaths, useTranslations } from "../../i18n/utils";
import banquet from "../../assets/photos/banquet.jpg";

export function getStaticPaths() { return localeStaticPaths(); }
const locale = getLocale(Astro.params);
const t = useTranslations(locale);
---
<Base title={t("sponsors.metaTitle")} description={t("sponsors.metaDescription")} locale={locale}>
  <section class="section">
    <div class="container-site">
      <SectionHeading title={t("sponsors.topTitle")} intro={t("sponsors.topIntro")} />
      <div class="mt-10 max-w-4xl"><SponsorGrid tier="top" /></div>
      <h2 class="mt-16 text-2xl font-bold text-red">{t("sponsors.more")}</h2>
      <div class="mt-6"><SponsorGrid tier="sponsor" /></div>
      <h2 class="mt-16 text-2xl font-bold text-red">{t("sponsors.partners")}</h2>
      <div class="mt-6"><SponsorGrid tier="partner" /></div>
    </div>
  </section>

  <section id="become-a-sponsor" class="section scroll-mt-20 bg-cream">
    <div class="container-site grid gap-12 lg:grid-cols-[7fr_5fr] lg:items-start">
      <div class="rounded-2xl bg-white p-5 shadow-card ring-1 ring-line/60 sm:p-8">
        <SectionHeading title={t("sponsors.becomeTitle")} intro={t("sponsors.becomeIntro")} />
        <div class="mt-8"><SponsorForm locale={locale} /></div>
      </div>
      <div>
        <Image src={banquet} alt={t("sponsors.banquetAlt")} class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card" widths={[600, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" />
        <div class="mt-6 rounded-xl bg-white p-5 ring-1 ring-line/60">
          <p class="font-bold">{t("sponsors.receiveTitle")}</p>
          <ul class="mt-3 space-y-2 text-sm text-ink/85">
            <li>· {t("sponsors.receive1")}</li>
            <li>· {t("sponsors.receive2")}</li>
            <li>· {t("sponsors.receive3")}</li>
            <li>· {t("sponsors.receive4")}</li>
          </ul>
          <p class="mt-4 text-sm text-muted">{t("sponsors.talkBefore")}<a href={`mailto:${site.email}`} class="font-semibold text-red underline">{site.email}</a>{t("sponsors.talkAfter")}</p>
        </div>
      </div>
    </div>
  </section>

  <Faq page="sponsors" locale={locale} />
  <FormScript locale={locale} />
</Base>
