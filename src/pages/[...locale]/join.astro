---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import MembershipForm from "../../components/MembershipForm.astro";
import Faq from "../../components/Faq.astro";
import FormScript from "../../components/FormScript.astro";
import { site, membership } from "../../lib/site";
import { getLocale, localeStaticPaths, useTranslations } from "../../i18n/utils";
import stage from "../../assets/photos/sca-stage.jpg";

export function getStaticPaths() { return localeStaticPaths(); }
const locale = getLocale(Astro.params);
const t = useTranslations(locale);
const priceLabel = locale === "zh" ? membership.priceLabelZh : membership.priceLabel;
---
<Base title={t("join.metaTitle")} description={t("join.metaDescription", { price: priceLabel })} locale={locale}>
  <section class="section bg-cream">
    <div class="container-site grid gap-12 lg:grid-cols-[4fr_7fr] lg:items-start">
      <div>
        <SectionHeading title={t("join.title")} intro={t("join.intro", { price: priceLabel })} />
        <ol class="mt-6 space-y-3 text-[15px]">
          <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-red text-sm font-bold text-white">1</span><span>{t("join.step1")}</span></li>
          <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-red text-sm font-bold text-white">2</span><span>{t("join.step2", { price: membership.price })}</span></li>
          <li class="flex gap-3"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-red text-sm font-bold text-white">3</span><span>{t("join.step3")}</span></li>
        </ol>
        <Image src={stage} alt={t("join.stageAlt")} class="mt-8 hidden aspect-[3/4] w-full rounded-xl object-cover shadow-card lg:block" widths={[480, 960]} sizes="(min-width: 1024px) 33vw, 100vw" />
      </div>
      <div class="rounded-2xl bg-white p-5 shadow-card ring-1 ring-line/60 sm:p-8">
        <h2 class="text-xl font-bold">{t("join.formTitle")}</h2>
        <p class="mb-5 text-sm text-muted">{t("join.requiredBefore")}<span class="text-red">*</span>{t("join.requiredAfter")}</p>
        <MembershipForm locale={locale} />
        <p class="mt-4 text-xs text-muted">{t("join.questionsBefore")}<a href={`mailto:${site.email}`} class="underline hover:text-red">{site.email}</a>{t("join.questionsAfter")}</p>
      </div>
    </div>
  </section>
  <div id="faq" class="scroll-mt-20"><Faq page="membership" title={t("join.faqTitle")} locale={locale} /></div>
  <FormScript locale={locale} />
</Base>
