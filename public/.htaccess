# Scarsdale Chinese Association — static Astro site on Hostinger (LiteSpeed/Apache)
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Force HTTPS and non-www
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Redirects from the old WordPress URLs
Redirect 301 /events-2/ /events/
Redirect 301 /events-2 /events/
Redirect 301 /events_old/ /events/
Redirect 301 /scarsdale-chinese-spring-festival-gala-2024/ /events/spring-festival-gala-2024/
Redirect 301 /free-movie-screening-of-sight/ /events/free-movie-screening-of-sight/
Redirect 301 /2024-new-year-melody/ /events/new-year-melody-2024/

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/avif "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
